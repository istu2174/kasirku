# ── Database ────────────────────────────────────────────────────────────────
# Dev lokal: SQLite (path relatif ke folder prisma/). Production: Postgres, lihat README.
DATABASE_URL="file:./data/kasirku.db"

# ── Aplikasi & sesi ─────────────────────────────────────────────────────────
# URL publik aplikasi (dipakai untuk link/QR struk digital di kertas struk)
APP_URL="http://localhost:3000"
# WAJIB diganti di production: string acak >= 32 karakter
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Auto-logout setelah idle (menit)
SESSION_IDLE_MINUTES=30

# ── Pembayaran ──────────────────────────────────────────────────────────────
# fake = simulator lokal (tanpa gateway) | midtrans = Midtrans sandbox/production
PAYMENT_PROVIDER="fake"
# Secret HMAC untuk webhook provider fake
PAYMENT_FAKE_SECRET="fake-secret-dev"
# Midtrans: ambil di dashboard Midtrans > Settings > Access Keys
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ── Queue ───────────────────────────────────────────────────────────────────
# Kosong = adapter in-memory (dev saja). Production: redis://localhost:6379
REDIS_URL=""

# ── Cetak struk ─────────────────────────────────────────────────────────────
# simulate = tandai tercetak tanpa printer | agent = kirim ke print agent lokal
PRINT_MODE="simulate"
PRINT_AGENT_URL="http://localhost:9100"
PRINT_AGENT_TOKEN="ganti-token-print-agent"
# Hanya dibaca oleh print agent (npm run print-agent):
# tcp://192.168.1.50:9100 | \\localhost\XP58 (Windows share) | /dev/usb/lp0 | stdout
PRINTER_TARGET="stdout"
PRINT_AGENT_HOST="127.0.0.1"

# ── PWA ─────────────────────────────────────────────────────────────────────
# 1 = daftarkan service worker juga saat dev (default hanya production)
NEXT_PUBLIC_SW=""
