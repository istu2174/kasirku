// Skema database KasirKu.
// Catatan: SQLite dipakai untuk dev lokal (tanpa Docker). Untuk production,
// ganti provider ke "postgresql" dan set DATABASE_URL (lihat README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Tenant & outlet ────────────────────────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  name         String
  businessMode String // KAFE | RESTORAN | MINIMARKET
  createdAt    DateTime @default(now())
  outlets      Outlet[]
  users        User[]
  auditLogs    AuditLog[]
}

model Outlet {
  id            String   @id @default(cuid())
  tenantId      String
  code          String   @unique // dipakai untuk nomor struk, mis. CRB
  name          String
  address       String
  phone         String
  businessMode  String // KAFE | RESTORAN | MINIMARKET
  taxConfig     String   @default("{\"taxPercent\":10,\"taxInclusive\":false,\"servicePercent\":5,\"roundingTo\":100}")
  receiptConfig String   @default("{\"footer\":\"Terima kasih atas kunjungan Anda\",\"header\":\"\"}")
  timezone      String   @default("Asia/Jakarta")
  createdAt     DateTime @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  categories    Category[]
  products      Product[]
  stocks        Stock[]
  orders        Order[]
  shifts        Shift[]
  tables        DiningTable[]
  userOutlets   UserOutlet[]
  receipts      Receipt[]
  sequences     ReceiptSequence[]
  auditLogs     AuditLog[]

  @@index([tenantId])
}

// ── User & akses ───────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  pinHash      String?
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt    DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  outlets     UserOutlet[]
  orders      Order[]
  shifts      Shift[]
  auditLogs   AuditLog[]
  refunds     Refund[]     @relation("RefundApprover")
}

model UserOutlet {
  id       String @id @default(cuid())
  userId   String
  outletId String
  role     String // OWNER | MANAGER | KASIR | DAPUR | GUDANG

  user   User   @relation(fields: [userId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([userId, outletId])
  @@index([outletId])
}

// ── Katalog ────────────────────────────────────────────────────────────────────
model Category {
  id        String @id @default(cuid())
  outletId  String
  name      String
  sortOrder Int    @default(0)

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  products Product[]

  @@index([outletId])
}

model Product {
  id         String   @id @default(cuid())
  outletId   String
  categoryId String?
  name       String
  sku        String
  barcode    String?
  price      Int // harga jual, integer rupiah
  cost       Int      @default(0)
  imageEmoji String   @default("🍽️")
  trackStock Boolean  @default(true)
  minQty     Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  outlet     Outlet           @relation(fields: [outletId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  modifierGroups ModifierGroup[]
  stocks     Stock[]
  movements  StockMovement[]
  orderItems OrderItem[]

  @@unique([outletId, sku])
  @@unique([outletId, barcode])
  @@index([outletId, isActive])
}

model ProductVariant {
  id         String @id @default(cuid())
  productId  String
  name       String
  priceDelta Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([productId])
}

model ModifierGroup {
  id        String @id @default(cuid())
  productId String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  product   Product    @relation(fields: [productId], references: [id])
  modifiers Modifier[]

  @@index([productId])
}

model Modifier {
  id         String @id @default(cuid())
  groupId    String
  name       String
  priceDelta Int    @default(0)

  group       ModifierGroup       @relation(fields: [groupId], references: [id])
  orderItemMods OrderItemModifier[]

  @@index([groupId])
}

// ── Stok ───────────────────────────────────────────────────────────────────────
model Stock {
  id        String @id @default(cuid())
  outletId  String
  productId String
  qty       Int    @default(0)
  minQty    Int    @default(0)

  outlet  Outlet  @relation(fields: [outletId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([outletId, productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  outletId  String
  productId String
  type      String // IN | OUT | ADJUSTMENT | SALE | REFUND
  qty       Int // positif masuk, negatif keluar
  refType   String? // ORDER | ADJUSTMENT | RECEIVE
  refId     String?
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([outletId, createdAt])
  @@index([productId])
}

// ── Meja ───────────────────────────────────────────────────────────────────────
model DiningTable {
  id       String @id @default(cuid())
  outletId String
  name     String
  capacity Int    @default(2)
  area     String @default("Utama")
  status   String @default("KOSONG") // KOSONG | TERISI | RESERVASI | PERLU_DIBERSIHKAN

  outlet Outlet  @relation(fields: [outletId], references: [id])
  orders Order[]

  @@unique([outletId, name])
}

// ── Shift ──────────────────────────────────────────────────────────────────────
model Shift {
  id           String    @id @default(cuid())
  outletId     String
  userId       String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingCash  Int       @default(0)
  expectedCash Int       @default(0)
  countedCash  Int?
  difference   Int?
  status       String    @default("OPEN") // OPEN | CLOSED
  note         String?

  outlet Outlet @relation(fields: [outletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([outletId, status])
}

// ── Order ──────────────────────────────────────────────────────────────────────
model Order {
  id          String    @id @default(cuid())
  outletId    String
  orderNo     String    @unique
  type        String    @default("DINE_IN") // DINE_IN | TAKEAWAY | DELIVERY | WALK_IN
  tableId     String?
  shiftId     String?
  cashierId   String
  status      String    @default("DRAFT") // DRAFT | CONFIRMED | PAID | CANCELLED | REFUNDED | PARTIALLY_REFUNDED
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  service     Int       @default(0)
  tax         Int       @default(0)
  rounding    Int       @default(0)
  grandTotal  Int       @default(0)
  note        String?
  guestCount  Int?
  oversold    Boolean   @default(false)
  needsReview Boolean   @default(false)
  clientRef   String?   @unique // id order offline dari perangkat (idempotensi sinkronisasi)
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  closedAt    DateTime?

  outlet  Outlet      @relation(fields: [outletId], references: [id])
  table   DiningTable? @relation(fields: [tableId], references: [id])
  shift   Shift?      @relation(fields: [shiftId], references: [id])
  cashier User        @relation(fields: [cashierId], references: [id])
  items   OrderItem[]
  payments Payment[]
  receipts Receipt[]

  @@index([outletId, createdAt])
  @@index([status])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  nameSnapshot  String
  qty           Int
  unitPrice     Int
  modifierTotal Int    @default(0)
  discount      Int    @default(0)
  lineTotal     Int
  note          String?
  kitchenStatus String @default("NEW") // NEW | IN_PROGRESS | READY | SERVED

  order     Order              @relation(fields: [orderId], references: [id])
  product   Product            @relation(fields: [productId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([kitchenStatus])
}

model OrderItemModifier {
  id            String @id @default(cuid())
  orderItemId   String
  modifierId    String
  nameSnapshot  String
  priceDelta    Int    @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
}

// ── Pembayaran ─────────────────────────────────────────────────────────────────
model Payment {
  id           String    @id @default(cuid())
  orderId      String
  method       String // CASH | QRIS | VA | MANUAL_TRANSFER | EWALLET
  provider     String    @default("CASH") // CASH | FAKE | MIDTRANS | XENDIT
  providerRef  String?
  amount       Int
  status       String    @default("UNPAID") // UNPAID | PENDING | PAID | EXPIRED | FAILED | NEEDS_REVIEW | REFUNDED
  amountReceived Int?
  change       Int?
  proofUrl     String?
  qrString     String?
  qrImageUrl   String?
  vaNumber     String?
  rawResponse  String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  expiresAt    DateTime?
  refundedAmount Int     @default(0)

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([providerRef])
  @@index([status])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String?
  providerEventId String   @unique
  provider        String
  status          String
  amount          Int      @default(0)
  payload         String
  headers         String?
  verified        Boolean  @default(false)
  receivedAt      DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([providerEventId])
}

model OrphanEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payload         String
  reason          String
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amount           Int
  reason           String
  approvedById     String
  providerRefundId String?
  status           String   @default("APPROVED")
  createdAt        DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id])
  approvedBy User    @relation("RefundApprover", fields: [approvedById], references: [id])

  @@index([paymentId])
}

// ── Struk ──────────────────────────────────────────────────────────────────────
model Receipt {
  id            String   @id @default(cuid())
  orderId       String
  outletId      String
  receiptNo     String   @unique
  kind          String   @default("SALE") // SALE | VOID | REFUND
  issuedAt      DateTime @default(now())
  printedCount  Int      @default(0)
  pdfUrl        String?
  digitalToken  String   @unique
  isOriginal    Boolean  @default(true)
  payloadJson   String // snapshot struk (immutable)

  order  Order  @relation(fields: [orderId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])
  jobs   PrintJob[]

  @@index([orderId])
}

model PrintJob {
  id        String   @id @default(cuid())
  receiptId String
  printerId String   @default("default")
  status    String   @default("QUEUED") // QUEUED | PRINTED | FAILED
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id])

  @@index([status])
}

model ReceiptSequence {
  id      String @id @default(cuid())
  outletId String
  dateKey String // YYYYMMDD
  lastSeq Int    @default(0)

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, dateKey])
}

// ── Audit ──────────────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String?
  userId    String?
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  outlet Outlet? @relation(fields: [outletId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}
